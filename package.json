{
    "name": "flex-template",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "npm-run-all --parallel dev:frontend dev:backend dev:agents",
        "build": "tsc -b && vite build",
        "typecheck": "tsc -p . --noEmit && npm --prefix agents run build",
        "test": "vitest run",
        "lint": "npm run typecheck && npx convex dev --once && npm run build",
        "dev:agents": "npm --prefix agents run build && npm-run-all --parallel dev:agent2 dev:agent3 dev:agent7 dev:agent-negotiation",
        "dev:agent2": "npm --prefix agents run dev:agent2",
        "dev:agent3": "npm --prefix agents run dev:agent3",
        "dev:agent7": "npm --prefix agents run build && npm --prefix agents run dev:agent7",
        "dev:agent-negotiation": "npm --prefix agents run dev:agent-negotiation",
        "dev:frontend": "vite",
        "dev:backend": "convex dev",
        "compile:runtime": "tsc -p tsconfig.runtime.json",
        "validate:runtime": "npm run compile:runtime && node dist/runtimeValidation/runner.js"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@types/node": "^20.11.0",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.27",
        "dotenv": "^16.4.7",
        "eslint": "^9.21.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^15.15.0",
        "husky": "^9.1.7",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.5.9",
        "prettier": "^3.5.3",
        "tailwindcss": "^3.4.17",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.24.1",
        "vite": "^6.2.0",
        "vitest": "^5.0.3"
    },
    "dependencies": {
        "@auth/core": "^0.37.0",
        "@convex-dev/auth": "^0.0.80",
        "@google/generative-ai": "^0.24.1",
        "@types/react-router-dom": "^5.3.3",
        "clsx": "^2.1.1",
        "convex": "^1.31.2",
        "katex": "^0.18.9",
        "lucide-react": "^0.564.0",
        "oauth4webapi": "^3.8.5",
        "oslo": "^1.2.0",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "react-latex-next": "^3.0.0",
        "react-router-dom": "^7.13.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.1.0"
    }
}
