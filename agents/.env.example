# Agent services (agents/.env). Copy to agents/.env and fill in.
# Convex deployment URL (the .convex.cloud one). Agents call Convex functions
# and route LLM calls through <deployment>.convex.site/api/gemini-proxy/.
CONVEX_URL=https://<your-deployment>.convex.cloud
# Gemini API key (forwarded by the proxy to Google's OpenAI-compatible endpoint).
GOOGLE_API_KEY=
# Optional, defaults to gemini-3.5-flash.
GEMINI_MODEL=
# Required. Shared secret for agent-to-agent calls (X-Agent-Key header) and for
# agent-to-Convex calls. Set the same value in Convex: npx convex env set AGENT_SECRET ...
AGENT_SECRET=
# Optional. When "true", guardrail/judge LLM outages are allowed through (local testing only).
MOCK_LLM=false
# Optional. Each service has its own default port (8081-8089). Cloud Run sets PORT itself.
# PORT=
